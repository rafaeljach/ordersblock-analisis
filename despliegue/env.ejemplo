# Copiar a /opt/ordersblock_analisis/.env y ajustar. Permisos: chmod 600 .env
# Clave larga y aleatoria (genera una con: openssl rand -hex 32)
ORDERSBLOCK_API_KEY=
# Orígenes web permitidos (la app nativa no usa CORS, solo la web)
ORDERSBLOCK_CORS=https://ordersblock.com,https://www.ordersblock.com
# Opcional: solo si quieres forex/acciones que Bybit TradFi no liste
TWELVEDATA_API_KEY=
# Límites
ORDERSBLOCK_LIMITE_MINUTO=20
ORDERSBLOCK_CONCURRENCIA=2
ORDERSBLOCK_VERIFICAR_CADA_SEG=120
ORDERSBLOCK_DB=/opt/ordersblock_analisis/memoria_ordersblock.db
# Escaner de oportunidades (segundo plano): universo, cada cuanto y pausa entre mercados
ORDERSBLOCK_ESCANER_MERCADOS=BTC,ETH,SOL,XRP,BNB,ADA,DOGE,LINK,AVAX,XAUUSD,XAGUSD,EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF,NZDUSD,EURJPY,GBPJPY
ORDERSBLOCK_ESCANER_CADA_SEG=900
ORDERSBLOCK_ESCANER_PAUSA_SEG=9
ORDERSBLOCK_ESCANER_ESPERANZA_MIN=0.05
ORDERSBLOCK_ESCANER_CONSENSO_MIN=55

# Cintillo de precios (/precios, publico). Cripto y oro desde Bybit; plata y forex desde
# Twelve Data solo si hay TWELVEDATA_API_KEY (1 credito por simbolo cada FX_SEG segundos, L-V).
ORDERSBLOCK_PRECIOS_CRIPTO_SEG=30
ORDERSBLOCK_PRECIOS_FX_SEG=600

# v119 · Sensor de rumores y noticias (hilo propio, base propia sensor.db). Apagado por defecto: 1 para encenderlo.
# El Worker NO lo lee hasta que se enciende sensor_worker en su configuracion (despues de 48 h estable).
ORDERSBLOCK_SENSOR=0
# ORDERSBLOCK_SENSOR_DB=/opt/ordersblock_analisis/sensor.db
# Bluesky (opcional, solo conteos): usuario y una CONTRASENA DE APP (Ajustes > Privacidad > Contrasenas de app). Nunca la principal.
# BLUESKY_HANDLE=
# BLUESKY_APP_PASSWORD=
# Umbrales (punto de partida; se calibran sin desplegar)
# ORDERSBLOCK_SENSOR_PROB_SALTO=0.05
# ORDERSBLOCK_SENSOR_VOL_MIN=50000
# ORDERSBLOCK_SENSOR_Z_SALTO=3
# ORDERSBLOCK_SENSOR_MAX_EVENTOS=25
# ORDERSBLOCK_SENSOR_KALSHI_SERIES=KXFED,KXFEDDECISION,KXCPI,KXCPIYOY,KXPAYROLLS,KXU3,KXGOVSHUT
# Brent desde Yahoo: apagado (sus condiciones no permiten uso comercial sin permiso). 1 solo con una fuente con licencia.
# ORDERSBLOCK_SENSOR_BRENT=0
