# Copiar a /opt/ordersblock_analisis/.env y ajustar. Permisos: chmod 600 .env
# Clave larga y aleatoria (genera una con: openssl rand -hex 32)
ORDERSBLOCK_API_KEY=
# Orígenes web permitidos (la app nativa no usa CORS, solo la web)
ORDERSBLOCK_CORS=https://ordersblock.com,https://www.ordersblock.com
# Opcional: solo si quieres forex/acciones que Bybit TradFi no liste
TWELVEDATA_API_KEY=
# Límites
ORDERSBLOCK_LIMITE_MINUTO=20
ORDERSBLOCK_CONCURRENCIA=2
ORDERSBLOCK_VERIFICAR_CADA_SEG=120
ORDERSBLOCK_DB=/opt/ordersblock_analisis/memoria_ordersblock.db
# Escaner de oportunidades (segundo plano): universo, cada cuanto y pausa entre mercados
ORDERSBLOCK_ESCANER_MERCADOS=BTC,ETH,SOL,XRP,BNB,ADA,DOGE,LINK,AVAX,XAUUSD,XAGUSD,EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF,NZDUSD,EURJPY,GBPJPY
ORDERSBLOCK_ESCANER_CADA_SEG=900
ORDERSBLOCK_ESCANER_PAUSA_SEG=9
ORDERSBLOCK_ESCANER_ESPERANZA_MIN=0.05
ORDERSBLOCK_ESCANER_CONSENSO_MIN=55
