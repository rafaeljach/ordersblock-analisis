# /etc/systemd/system/ordersblock-noticias.service
# Lee las fuentes de noticias y traduce los titulares con modelos locales (Argos/CTranslate2).
# Proceso aparte del motor y con su propio tope de memoria: si el traductor se pasa, solo se reinicia este
# servicio; el motor, el bot (icc) y la billetera no se enteran.
[Unit]
Description=ordersblock - noticias (fuentes + traduccion local)
After=network-online.target
Wants=network-online.target

[Service]
User=analisis
WorkingDirectory=/opt/ordersblock_analisis
EnvironmentFile=/opt/ordersblock_analisis/.env
Environment=OMP_NUM_THREADS=1
ExecStart=/opt/ordersblock_analisis/venv/bin/python noticias.py servicio
Restart=always
RestartSec=15
MemoryHigh=550M
MemoryMax=700M
CPUQuota=50%
Nice=10
LogNamespace=ordersblock
# Mismas protecciones que el motor (paso 2 del kit de seguridad)
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ordersblock_analisis
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
